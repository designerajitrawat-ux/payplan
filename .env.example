# Copy to .env.local for local runs. Never commit real values.
# In the cloud environment these are set in the environment settings, not in files.

# PayPal sandbox app (Developer Dashboard > Apps & Credentials, Sandbox)
# Leave both empty to run with a simulated PayPal (local runs only; every screen says so).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | simulated
PAYPAL_ENV=sandbox

# Sandbox test accounts used by the end-to-end tests
PAYPAL_BUYER_EMAIL=
PAYPAL_BUYER_PASSWORD=
PAYPAL_IN_BUSINESS_EMAIL=
PAYPAL_IN_PERSONAL_EMAIL=

# Webhook ID from the sandbox app, used to verify webhook signatures (Phase 1)
PAYPAL_WEBHOOK_ID=

# AI checker (Phase 2): any OpenAI-compatible endpoint; default is Google AI Studio (Gemini)
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash
# Optional: Google API key with the PageSpeed Insights API enabled (mobile audit and page screenshot)
PAGESPEED_API_KEY=

# Database: Neon Postgres connection string. Leave empty to use an embedded Postgres in .data/
DATABASE_URL=
# Optional folder for the embedded Postgres (default: .data/pglite)
PGLITE_DIR=

# Ed25519 key that signs acceptance reports (npm run keys:generate). Local runs keep one in .data/.
REPORT_SIGNING_KEY=

# Timer job: the scheduled GitHub Action sends this as a Bearer token to /api/cron/due
CRON_SECRET=

# Demo buttons that end review/fix windows early (on unless set to "off")
DEMO_TIME_CONTROLS=
# Local runs may check http://localhost pages (the sample site). Never set this in production.
ALLOW_PRIVATE_URLS=
